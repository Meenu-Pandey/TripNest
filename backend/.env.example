# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://tripnest:tripnest@localhost:5432/tripnest?schema=public"

# Symmetric secret used to sign JWTs. Generate a long random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"

# JWT lifetime, e.g. "15m", "1h", "7d".
JWT_EXPIRES_IN="1h"

NODE_ENV="development"
PORT="4000"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:3000"

# Optional. Used as the contact identifier in the required User-Agent
# header for Nominatim geocoding requests (see
# src/providers/geocoding/nominatimProvider.ts and Nominatim's usage
# policy at operations.osmfoundation.org/policies/nominatim/). Not
# required for the app to start.
TRIPNEST_CONTACT_EMAIL=""

# Directory for the local-disk storage backend (memory photo uploads).
# See src/lib/storage/localDiskStorage.ts.
UPLOADS_DIR="./uploads"

# Application URL used to generate reset password and invitation links in emails.
# Production must set this to the deployed public frontend URL (e.g., https://yourdomain.com).
APP_URL="http://localhost:3000"

# Email Delivery Provider: "console" (default for local dev) or "smtp" (for real production email delivery).
EMAIL_PROVIDER="console"

# SMTP Server Configuration (Required when EMAIL_PROVIDER="smtp")
# For Gmail SMTP testing/QA:
#   SMTP_HOST="smtp.gmail.com"
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER="your-email@gmail.com"
#   SMTP_PASSWORD="your-16-character-app-password"
# NOTE: Gmail requires an App Password from Google Account Security, NOT your standard password!
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""

# Configurable sender email address & display name.
# For console mode: "TripNest <invites@tripnest.local>"
# For production SMTP: Must match or be authorized by your authenticated SMTP user account.
EMAIL_FROM="TripNest <invites@tripnest.local>"
