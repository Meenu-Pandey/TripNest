# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://tripnest:tripnest@localhost:5432/tripnest?schema=public"

# Symmetric secret used to sign JWTs. Generate a long random value, e.g.:
#   openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"

# JWT lifetime, e.g. "15m", "1h", "7d".
JWT_EXPIRES_IN="1h"

NODE_ENV="development"
PORT="4000"

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:3000"

# Optional. Used as the contact identifier in the required User-Agent
# header for Nominatim geocoding requests (see
# src/providers/geocoding/nominatimProvider.ts and Nominatim's usage
# policy at operations.osmfoundation.org/policies/nominatim/). Not
# required for the app to start.
TRIPNEST_CONTACT_EMAIL=""

# Directory for the local-disk storage backend (memory photo uploads).
# See src/lib/storage/localDiskStorage.ts.
UPLOADS_DIR="./uploads"
